{
  "appId": "com.racesamples.cbc",
  "productName": "RACE SAMPLES",
  "copyright": "Copyright © 2026 FIRST LAB. All rights reserved.",
  "directories": {
    "output": "dist"
  },
  "files": [
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone",
      "filter": [
        "**/*",
        "!**/*.map"
      ]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "standalone/node_modules",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/images/logo.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "RACE SAMPLES",
    "uninstallDisplayName": "RACE SAMPLES Laboratory System",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  },
  "publish": [
    {
      "provider": "github",
      "owner": "AbdulRazzaque",
      "repo": "Race-Sample",
      "releaseType": "release"
    }
  ]
}
