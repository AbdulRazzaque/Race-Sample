# RACE SAMPLES — Environment Configuration Template

DATABASE_URL="file:./race_samples.db"
SESSION_SECRET="your_long_random_session_secret_key_at_least_32_chars"
APP_URL="http://localhost:3000"

# Initial Admin Bootstrap Credentials (used only during initial seed/bootstrap)
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="your_secure_password"

# Default Thresholds
DEFAULT_HGB_THRESHOLD=14.0
DEFAULT_HCT_THRESHOLD=32.0

# Organization Defaults
DEFAULT_ORG_NAME="FIRST LAB"
DEFAULT_ORG_NAME_AR="المختبر الأول"
DEFAULT_EVENT_NAME="المهرجان الصيفي"
DEFAULT_RECIPIENT_NAME="الساده/ اللجنة المنظمة لسباق الهجن"
